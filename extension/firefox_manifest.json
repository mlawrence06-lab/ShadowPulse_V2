{
  "manifest_version": 3,
  "name": "ShadowPulse",
  "version": "2.3.2",
  "description": "BitcoinTalk Alternative Recognition Tool",
  "browser_specific_settings": {
    "gecko": {
      "id": "shadowpulse@shadowpulse.live",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity", "websiteActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://bitcointalk.org/*",
    "https://shadowpulsev2.b-cdn.net/*",
    "https://shadowpulse.live/*"
  ],
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": ["scripts/theme_boot.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": [
        "scripts/utils.js",
        "scripts/ui.js",
        "scripts/faucet.js",
        "scripts/stats.js",
        "scripts/pulse.js",
        "scripts/main.js"
      ],
      "css": ["style/main.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/config.js", "style/main.css"],
      "matches": ["*://bitcointalk.org/*"]
    }
  ]
}
