{
  "manifest_version": 3,
  "name": "ShadowPulse",
  "version": "2.5.2",
  "description": "BitcoinTalk Alternative Recognition Tool",
  "browser_specific_settings": {
    "gecko": {
      "id": "shadowpulse@shadowpulse.live",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "permissions": ["storage", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://bitcointalk.org/*",
    "https://shadowpulsev2.b-cdn.net/*",
    "https://shadowpulse.live/*"
  ],
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": [
        "scripts/theme_boot.js",
        "scripts/utils.js",
        "scripts/ui.js",
        "scripts/faucet.js",
        "scripts/stats.js",
        "scripts/pulse.js",
        "scripts/main.js"
      ],
      "css": ["style/main.css"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ShadowPulse"
  },
  "web_accessible_resources": [
    {
      "resources": ["style/main.css"],
      "matches": ["*://bitcointalk.org/*"]
    }
  ]
}
