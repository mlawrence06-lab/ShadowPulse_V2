{
  "manifest_version": 3,
  "name": "ShadowPulse",
  "version": "1.9.84",
  "description": "BitcoinTalk Alternative Recognition Tool",
  "permissions": ["storage"],
  "host_permissions": [
    "*://bitcointalk.org/*",
    "https://shadowpulsev2.b-cdn.net/*",
    "https://shadowpulse.live/*"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": ["scripts/theme_boot.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": ["scripts/loader.js"],
      "css": ["style/main.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/main.js",
        "scripts/utils.js",
        "scripts/words.js",
        "scripts/ui.js",
        "scripts/config.js",
        "style/main.css"
      ],
      "matches": ["*://bitcointalk.org/*"]
    }
  ]
}
