{
  "manifest_version": 3,
  "name": "ShadowPulse V2",
  "version": "0.5.3",
  "description": "BitcoinTalk Real-time Voting (Pilot)",
  "permissions": ["storage"],
  "host_permissions": [
    "*://bitcointalk.org/*",
    "https://shadowpulsev2.b-cdn.net/*",
    "http://192.168.1.12/*"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": ["scripts/loader.js"],
      "css": ["style/main.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/main.js",
        "scripts/votes.js",
        "scripts/utils.js",
        "scripts/words.js",
        "scripts/ui.js",
        "scripts/config.js",
        "style/main.css"
      ],
      "matches": ["*://bitcointalk.org/*"]
    }
  ]
}
