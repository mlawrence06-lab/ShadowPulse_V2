{
  "manifest_version": 3,
  "name": "ShadowPulse",
  "version": "2.4.0",
  "description": "BitcoinTalk Alternative Recognition Tool",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://bitcointalk.org/*",
    "https://shadowpulsev2.b-cdn.net/*",
    "https://shadowpulse.live/*"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://bitcointalk.org/*"],
      "js": [
        "scripts/theme_boot.js",
        "scripts/utils.js",
        "scripts/ui.js",
        "scripts/faucet.js",
        "scripts/stats.js",
        "scripts/pulse.js",
        "scripts/main.js"
      ],
      "css": ["style/main.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style/main.css"],
      "matches": ["*://bitcointalk.org/*"]
    }
  ]
}
